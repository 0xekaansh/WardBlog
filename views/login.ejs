<%- include("partials/header.ejs") %>

<div class="form-container">
    <h1>Log In</h1>

    <% if (locals.error) { %>
      <p class="error-msg" style="color: var(--danger-color); margin-bottom: 1rem;"><%= error %></p>
    <% } %>

    <div class="createBox main-container">
        <form id="loginForm" method="post" action="/login">
            <div>
              <label for="email">Email</label>
              <input type="email" name="email" id="email" placeholder="name@example.com" required />
            </div>
      
            <div>
              <label for="password">Password</label>
              <input type="password" name="password" id="password" placeholder="••••••••" required />
            </div>
      
            <button type="submit">Log In</button>
          </form>
    </div>
    <p class="alternate" style="margin-top: 1.5rem; text-align: center; color: var(--text-muted);">
      Don't have an account? <a href="/register" style="color: var(--text-primary); font-weight: 600;">Register</a>
    </p>
</div>

<%- include("partials/footer.ejs") %>