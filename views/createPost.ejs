<%- include("partials/header.ejs") %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />

<div class="form-container">
  <h1><%= heading %></h1>
  <div class="createBox">
    <form action="<%= typeof post !== 'undefined' ? '/api/posts/' + post.id : '/api/posts' %>" method="POST" id="postForm">
      <div>
        <label for="title">Title</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          placeholder="Enter blog title here..." 
          value="<%= typeof post !== 'undefined' ? post.title : '' %>" 
          required 
        />
      </div>

      <div class="quill-container">
        <label for="content-editor">Content</label>
        <!-- quill.js editor container -->
        <div id="editor-container">
          <%- typeof post !== 'undefined' ? post.content : '' %>
        </div>
        <!-- hidden input to link quill editor data to content before form submission -->
        <input type="hidden" name="content" id="contentInput" />
      </div>

      <button type="submit" class="btn btn-primary"><%= submit %></button>
    </form>
  </div>
</div>

<!-- quill.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<script>
  const quill = new Quill('#editor-container', {
    theme: 'snow',
    placeholder: 'Enter blog content here...',
    modules: {
      toolbar: [
        [{ 'header': [1, 2, 3, false] }, 
        'bold', 'italic', 'underline', 'strike', 
        'code',
        'code-block',
        'blockquote', 
        { 'list': 'ordered' }, 
        { 'list': 'bullet' },
        'link', 
        'clean']
      ]
    }
  });

  // toolbar customization
  const toolbar = quill.getModule('toolbar');
  
  // inline code button
  const codeButton = toolbar.container.querySelector('.ql-code');
  if (codeButton) {
    codeButton.innerHTML = `<svg viewBox="0 0 18 18"><polyline class="ql-stroke" points="5 3 1 9 5 15"></polyline><polyline class="ql-stroke" points="13 3 17 9 13 15"></polyline></svg>`;
  }

  // code block button
  const codeBlockButton = toolbar.container.querySelector('.ql-code-block');
  if (codeBlockButton) {
    codeBlockButton.innerHTML = `<svg viewBox="0 0 18 18"><path class="ql-stroke" d="M3,5 L6,9 L3,13"></path><path class="ql-stroke" d="M15,5 L12,9 L15,13"></path><line class="ql-stroke" x1="10" y1="3" x2="8" y2="15"></line></svg>`;
  }
  
  const tooltips = {
    'ql-bold': 'Bold',
    'ql-italic': 'Italic',
    'ql-underline': 'Underline',
    'ql-strike': 'Strikethrough',
    'ql-code': 'Inline Code',
    'ql-code-block': 'Code Block',
    'ql-blockquote': 'Blockquote',
    'ql-link': 'Insert Link',
    'ql-clean': 'Clear Formatting'
  };

  Object.keys(tooltips).forEach(className => {
    const btn = toolbar.container.querySelector('.' + className);
    if (btn) btn.setAttribute('title', tooltips[className]);
  });

  const form = document.getElementById('postForm');
  const contentInput = document.getElementById('contentInput');

  form.addEventListener('submit', function (e) {
    contentInput.value = quill.getSemanticHTML();
    
    if (quill.getText().trim().length === 0) {
      e.preventDefault();
      alert('Article content cannot be empty.');
    }
  });
</script>
<%- include("partials/footer.ejs") %>
