<%- include("partials/header.ejs") %>

<div class="form-container">
  <h1><%= heading %></h1>

  <% if (locals.post) { %>
    <div class="createBox main-container">
      <form id="editBlogForm" method="post" action="/api/posts/<%= post.id %>">
        <div class="blog-title">
          <label for="title">Title</label>
          <input type="text" name="title" placeholder="Blog Title" value="<%= post.title %>" required />
        </div>
        <div class="blog-content">
          <label for="content">Content</label>
          <textarea name="content" rows="5" placeholder="Blog Content" required ><%= post.content %></textarea>
        </div>
        <div class="blog-author">
          <label for="author">Author</label>
          <input type="text" name="author" placeholder="Author Name" value="<%= post.author %>" required />
        </div>
        <button type="submit"><%= submit %></button>
      </form>
    </div>
    <% } else { %>
      <div class="createBox main-container">
        <form id="newBlogForm" method="post" action="/api/blog">
          <div class="blog-title">
            <label for="title">Title</label>
            <input type="text" name="title" placeholder="Blog Title" required />
          </div>
          <div class="blog-content">
            <label for="content">Content</label>
            <textarea name="content" rows="5" placeholder="Blog Content" required ></textarea>
          </div>
          <div class="blog-author">
            <label for="author">Author</label>
            <input type="text" name="author" placeholder="Author Name" required />
          </div>
          <button type="submit"><%= submit %></button>
        </form>
      </div>
      <% } %>
</div>
<%- include("partials/footer.ejs") %>
