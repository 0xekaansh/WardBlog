<%- include("partials/header.ejs") %>

<div class="profile-container main-container">
  <div class="profile-card public-profile">
    <div class="card-header">
      <h1>Public Profile</h1>
      <p class="section-desc">Manage your public information and display identity.</p>
    </div>
    <% if (locals.profileError) { %>
        <p class="alert-msg error"><%= profileError %></p>
      <% } %>
    <form id="edit-profile" method="post" action="/api/updateProfile" class="profile-form">
      <div class="form-group profile-name">
        <label for="name">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          value="<%= profile.name || '' %>"
          placeholder="Your Name Here"
          required
        />
      </div>
      <div class="form-group username">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= profile.username || '' %>"
          placeholder="Your Username Here"
          readonly
          tabindex="-1"
          class="input-readonly"
        />
        <small class="field-hint">Usernames cannot be changed.</small>
      </div>
      <div class="form-group email">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= profile.email || '' %>"
          placeholder="Your Email Here"
        />
      </div>
      <div class="form-group bio">
        <label for="bio">Bio</label>
        <textarea
          type="text"
          id="bio"
          name="bio"
          placeholder="Tell readers a bit about your work and tech journey..."
        ><%= profile.bio || '' %></textarea>
      </div>
      <div class="form-group github">
        <label for="github">Github</label>
        <input
          type="url"
          id="github"
          name="github"
          value="<%= profile.github || '' %>"
          placeholder="Add Your Github Profile Link Here"
        />
      </div>
      <div class="form-group linkedin">
        <label for="linkedin">LinkedIn</label>
        <input
          type="url"
          id="linkedin"
          name="linkedin"
          value="<%= profile.linkedin || '' %>"
          placeholder="Add Your linkedin Profile Link Here"
        />
      </div>
      <div class="form-group instagram">
        <label for="instagram">Instagram</label>
        <input
          type="url"
          id="instagram"
          name="instagram"
          value="<%= profile.instagram || '' %>"
          placeholder="Add Your Instagram Profile Link Here"
        />
      </div>
      <button type="submit" class="btn btn-primary profile-btn">Save Profile</button>
    </form>
  </div>
  <div class="profile-card update-password">
    <div class="card-header">
      <h2>Change Password</h2>
      <p class="section-desc">Update your credentials to keep your account safe.</p>
    </div>

    <% if (locals.passwordError) { %>
      <p class="alert-msg error"><%= passwordError %></p>
    <% } %>

    <form id="new-password" method="post" action="/api/changePassword" class="profile-form">
        <div class="form-group old-password">
            <label for="oldPassword">Old Password</label>
            <input type="password" name="oldPassword" id="oldPassword" placeholder="Enter your current password" required /> 
        </div>
        <div class="form-group new-password">
            <label for="newPassword">New Password</label>
            <input type="password" name="newPassword" id="newPassword" placeholder="Enter a new password" required /> 
        </div>
        <button type="submit" class="btn btn-secondary profile-btn">Update Password</button>
    </form>
  </div>
</div>

<%- include("partials/footer.ejs") %>
