<%- include("partials/header.ejs") %>

<div class="profile main-container">
  <div class="public-profile">
    <span><h1>Public Profile</h1></span>
    <% if (locals.profileError) { %>
        <p class="error-msg" style="color: var(--danger-color); margin-bottom: 1rem;"><%= profileError %></p>
      <% } %>
    <form id="edit-profile" method="post" action="/api/updateProfile">
      <div class="profile-name">
        <label for="name">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          value="<%= profile.name %>"
          placeholder="Your Name Here"
          required
        />
      </div>
      <div class="username">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= profile.username %>"
          placeholder="Your Username Here"
          readonly
          tabindex="-1"
          class="input-readonly"
        />
        <small style="color: var(--text-muted); font-size: 0.8rem"
          >Usernames cannot be changed.</small
        >
      </div>
      <div class="email">
        <label for="email">Email</label>
        <input
          type="text"
          id="email"
          name="email"
          value="<%= profile.email %>"
          placeholder="Your Email Here"
        />
      </div>
      <div class="Bio">
        <label for="bio">Bio</label>
        <textarea
          type="text"
          id="bio"
          name="bio"
          value=""
          placeholder="Your Bio Here"
          required
        >
<%= profile.bio %></textarea
        >
      </div>
      <button type="submit">Save</button>
    </form>
  </div>
  <div class="update-password">
    <form id="new-password" method="post" action="/api/changePassword">
        <span><h1>Change Password</h1></span>
        <% if (locals.passwordError) { %>
            <p class="error-msg" style="color: var(--danger-color); margin-bottom: 1rem;"><%= passwordError %></p>
          <% } %>
        <div class="old-password">
            <label for="oldPassword">Old Password</label>
            <input type="password" name="oldPassword" id="password" placeholder="Your old password here" required /> 
        </div>
        <div class="new-password">
            <label for="newPassword">New Password</label>
            <input type="password" name="newPassword" id="password" placeholder="Your new password here" required /> 
        </div>
        <button type="submit">Update Password</button>
    </form>
  </div>
</div>

<%- include("partials/footer.ejs") %>
