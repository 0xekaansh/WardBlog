<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/styles/style.css" rel="stylesheet" />
    <title>WardBlog</title>
  </head>
  <body>
    <header class="header">
      <nav class="navbar">
        <div class="logo"><a href="/">WardBlog</a></div>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/blogs">Read Blogs</a>
          <% if(locals.currentUser) { %>
            <a href="/new">Create Blog</a>
            <div class="dropdown">
              <button type="button" class="dropdown-toggle" aria-expanded="false">
                <span><%= currentUser.username %></span>
                <span class="arrow-icon">&#9662;</span>
              </button>

              <div class="dropdown-menu">
                <a href="/profile">My Profile</a>
                <a href="/my-posts">My Articles</a>
                <hr class="dropdown-divider">
                <a href="/logout" class="dropdown-item-danger">Log Out</a>
              </div>
            </div>
            <% } else { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
              <% } %>
            </div>
    </nav>
    </header>
