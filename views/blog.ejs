<%- include("partials/header.ejs") %>

<main class="main-container">
  <div class="main-heading"><h1>Welcome</h1></div>
  
  <div class="posts"><ul id="postsList">
    <% posts.forEach(post=> { %>
      <li>
        <h2>
          <%=post.title%>
        </h2>
        <small>
          <%= new Date(post.date).toLocaleDateString("en-US", { year: 'numeric', month: 'short', day: 'numeric' }) %>
        </small>
        <p>
          <%=post.content%>
        </p>
        <div class="post-actions">
          <small>By: <%=post.author%> </small>
          <a class="edit-btn" href="/edit/<%= post.id %>">Edit</a>
          <form action="/api/posts/delete/<%= post.id %>" method="POST" style="display:inline;">
            <button type="submit" class="delete-btn" onclick="return confirm('Delete this post?');">Delete</button>
          </form>
        </div>
      </li>
      <% }); %>
  </ul>
</div>
</main>

<%- include("partials/footer.ejs") %>
