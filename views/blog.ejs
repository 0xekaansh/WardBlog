<%- include("partials/header.ejs") %>

<main class="main-container">
  <div class="main-heading"><h1>Articles</h1></div>
  
  <div class="posts">
    <ul id="postsList">
      <% posts.forEach(post=> { %>
        <li>
          <h2>
            <a href="/blogs/<%= post.id %>" class="post-title-link">
              <%=post.title%>
            </a>
          </h2>

          <div class="post-header-meta">
            <a href="/publicProfile/<%= post.user_id %>">
              <span class="author-name"><%= post.display_name %></span>
              <span class="author-handle">@<%= post.username %></span>
            </a>
            <span class="post-date">
              &bull; <%= new Date(post.date).toLocaleDateString("en-US", { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </span>
          </div>

          <p class="post-preview">
            <%= post.content.length > 160 ? post.content.substring(0, 160) + '...' : post.content %>
          </p>

          <a href="/blogs/<%= post.id %>" class="read-more-btn">Read Article &rarr;</a>
        </li>
      <% }); %>
    </ul>
  </div>
</main>

<%- include("partials/footer.ejs") %>
